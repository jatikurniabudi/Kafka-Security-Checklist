# Copy ke .env lalu isi. JANGAN commit .env ke git.

KAFKA_UI_BASE_URL=
KAFKA_UI_CLUSTER_NAME=

KAFKA_UI_USERNAME=
KAFKA_UI_PASSWORD=

# --- Biasanya tidak perlu diubah, tapi sesuaikan kalau login otomatis gagal ---
# Buka Network tab browser saat login manual ke dashboard, lihat:
# 1. Path halaman login (biasanya /auth atau /login) -> KAFKA_UI_LOGIN_PAGE_PATH
# 2. Path yang menerima POST kredensial (kadang sama, kadang beda) -> KAFKA_UI_LOGIN_SUBMIT_PATH
# 3. Nama field di form/payload POST -> KAFKA_UI_USERNAME_FIELD, KAFKA_UI_PASSWORD_FIELD
KAFKA_UI_LOGIN_PAGE_PATH=/auth
KAFKA_UI_LOGIN_SUBMIT_PATH=/login
KAFKA_UI_USERNAME_FIELD=username
KAFKA_UI_PASSWORD_FIELD=password

KAFKA_UI_VERIFY_TLS=true
KAFKA_UI_TIMEOUT=15
